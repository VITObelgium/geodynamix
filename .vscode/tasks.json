{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "command": "pixi",
            "problemMatcher": [
                "$rustc"
            ],
            "args": [
                "run",
                "maturin",
                "develop"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "label": "rust: maturin develop"
        },
        {
            "type": "process",
            "command": "pixi",
            "problemMatcher": [
                "$rustc"
            ],
            "args": [
                "run",
                "test"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "label": "rust: maturin test"
        }
    ]
}