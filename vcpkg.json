{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "my-application",
    "version": "0.14.6",
    "dependencies": [
        "benchmark",
        "zlib",
        "fmt",
        "spdlog",
        "eigen3",
        "date",
        "geos",
        {
            "name": "proj",
            "features": ["embed-data"]
        },
        {
            "name": "gdal",
            "default-features": false,
            "features": [
                "gif",
                "png",
                "expat",
                "netcdf",
                "geos",
                "sqlite3",
                "hdf5"
            ]
        },
        "bfgroup-lyra",
        "trompeloeil",
        "doctest",
        "pybind11",
        "vc"
    ],
    "vcpkg-configuration": {
        "default-registry": {
            "kind": "git",
            "baseline": "c3867e714dd3a51c272826eea77267876517ed99",
            "repository": "https://github.com/microsoft/vcpkg"
        },
        "overlay-ports": ["./deps/infra/vcpkg_overlay/ports"],
        "overlay-triplets": ["./deps/infra/vcpkg_overlay/triplets"]
    }
}
