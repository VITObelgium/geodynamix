{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 8,
    "include": ["deps/infra/vcpkg_overlay/CMakePresets.json"],
    "configurePresets": [
        {
            "name": "project-base",
            "hidden": true,
            "cacheVariables": {
                "GDX_ENABLE_TESTS": "ON",
                "GDX_PYTHON_BINDINGS": "ON",
                "GDX_ENABLE_BENCHMARKS": "ON",
                "GDX_ENABLE_SIMD": "ON",
                "GDX_ENABLE_GEOMETRY": "ON",
                "BUILD_TESTING": "ON"
            },
            "environment": {
                "VCPKG_ROOT": "${sourceDir}/build/vcpkg"
            }
        },
        {
            "name": "nix",
            "binaryDir": "${sourceDir}/build/nix",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "CMAKE_EXE_LINKER_FLAGcdS": "-fuse-ld=gold -static-libstdc++ -static-libgcc"
            },
            "environment": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
            }
        },
        {
            "name": "x64-windows-static",
            "displayName": "Windows ninja",
            "inherits": [
                "project-base",
                "triplet-x64-windows-static",
                "build-system-ninja-multi",
                "windows-msvc-common"
            ],
            "binaryDir": "${sourceDir}/build/gdx-ninja"
        },
        {
            "name": "x64-windows-static-dist",
            "displayName": "Windows ninja",
            "inherits": [
                "project-base",
                "triplet-x64-windows-static",
                "build-system-ninja",
                "windows-msvc-common"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PACKAGE_VERSION_COMMITHASH": "$env{GIT_COMMIT_HASH}"
            },
            "binaryDir": "${sourceDir}/build/gdx-x64-windows-static-dist"
        },
        {
            "name": "x64-windows-static-vs",
            "displayName": "Visual Studio",
            "inherits": [
                "project-base",
                "triplet-x64-windows-static",
                "build-system-visualstudio"
            ],
            "binaryDir": "${sourceDir}/build/gdx-vs"
        }
    ],
    "buildPresets": [
        {
            "name": "x64-windows-static-debug",
            "configurePreset": "x64-windows-static",
            "displayName": "Windows x64 Debug",
            "description": "Debug build",
            "configuration": "Debug"
        },
        {
            "name": "x64-windows-static-release",
            "configurePreset": "x64-windows-static",
            "displayName": "Windows x64 Release",
            "description": "Release build",
            "configuration": "Release"
        },
        {
            "name": "x64-windows-static-dist",
            "configurePreset": "x64-windows-static-dist",
            "displayName": "Windows x64 Dist",
            "description": "Dist build"
        },
        {
            "name": "nix-debug",
            "configurePreset": "nix",
            "displayName": "Debug Nix Build",
            "configuration": "Debug"
        },
        {
            "name": "nix-release",
            "configurePreset": "nix",
            "displayName": "Release Nix Build",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "x64-windows-static-debug",
            "description": "Unit tests",
            "configurePreset": "x64-windows-static",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x64-windows-static-release",
            "description": "Unit tests",
            "configurePreset": "x64-windows-static",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x64-windows-static-dist",
            "description": "Unit tests for windows distribution build",
            "configurePreset": "x64-windows-static-dist",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "nix-debug",
            "description": "Unit tests",
            "configurePreset": "nix",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "nix-release",
            "description": "Unit tests",
            "configurePreset": "nix",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
