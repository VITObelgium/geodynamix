{
    "$schema": "https://raw.githubusercontent.com/Kitware/CMake/v3.31.10/Help/manual/presets/schema.json",
    "version": 8,
    "include": ["deps/infra/vcpkg_overlay/CMakePresets.json"],
    "configurePresets": [
        {
            "name": "project-base",
            "hidden": true,
            "cacheVariables": {
                "GDX_ENABLE_TESTS": "ON",
                "GDX_PYTHON_BINDINGS": "ON",
                "GDX_ENABLE_BENCHMARKS": "ON",
                "GDX_ENABLE_SIMD": "ON",
                "GDX_ENABLE_GEOMETRY": "ON",
                "BUILD_TESTING": "ON"
            },
            "environment": {
                "VCPKG_ROOT": "${sourceDir}/build/vcpkg"
            }
        },
        {
            "name": "nix",
            "binaryDir": "${sourceDir}/build/nix-static",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "GDX_ENABLE_TESTS": "ON",
                "GDX_ENABLE_TEST_UTILS": "ON",
                "GDX_ENABLE_SIMD": "ON",
                "GDX_USE_LIBCXX": "ON",
                "CMAKE_PREFIX_PATH": "$env{GDX_STATIC_DEPS}",
                "CMAKE_C_COMPILER": "$env{GDX_STATIC_C_COMPILER}",
                "CMAKE_CXX_COMPILER": "$env{GDX_STATIC_CXX_COMPILER}",
                "CMAKE_C_COMPILER_LAUNCHER": "sccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
            },
            "environment": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "PKG_CONFIG_LIBDIR": "$env{GDX_STATIC_DEPS}/lib/pkgconfig:$env{GDX_STATIC_DEPS}/share/pkgconfig"
            }
        },
        {
            "name": "x64-windows-static",
            "displayName": "Windows ninja",
            "inherits": [
                "project-base",
                "triplet-x64-windows-static",
                "build-system-ninja-multi",
                "windows-msvc-common"
            ],
            "binaryDir": "${sourceDir}/build/gdx-ninja"
        },
        {
            "name": "x64-windows-static-dist-base",
            "hidden": true,
            "inherits": [
                "project-base",
                "triplet-x64-windows-static",
                "build-system-ninja",
                "windows-msvc-common"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PACKAGE_VERSION_COMMITHASH": "$env{GIT_COMMIT_HASH}"
            }
        },
        {
            "name": "x64-windows-static-dist",
            "displayName": "Windows ninja",
            "inherits": "x64-windows-static-dist-base",
            "binaryDir": "${sourceDir}/build/gdx-x64-windows-static-dist"
        },
        {
            "name": "standalone-py314",
            "displayName": "Standalone Python 3.14",
            "inherits": "x64-windows-static-dist-base",
            "binaryDir": "${sourceDir}/build/gdx-standalone-314",
            "cacheVariables": {
                "Python3_ROOT_DIR": "$env{PYTHON314}",
                "Python3_EXECUTABLE": {
                    "type": "FILEPATH",
                    "value": "$env{PYTHON314}/python.exe"
                },
                "_Python3_INCLUDE_DIR": {
                    "type": "PATH",
                    "value": "$env{PYTHON314}/include"
                },
                "_Python3_LIBRARY_RELEASE": {
                    "type": "FILEPATH",
                    "value": "$env{PYTHON314}/libs/python314.lib"
                }
            }
        },
        {
            "name": "standalone-py313",
            "displayName": "Standalone Python 3.13",
            "inherits": "x64-windows-static-dist-base",
            "binaryDir": "${sourceDir}/build/gdx-standalone-313",
            "cacheVariables": {
                "Python3_ROOT_DIR": "$env{PYTHON313}",
                "Python3_EXECUTABLE": {
                    "type": "FILEPATH",
                    "value": "$env{PYTHON313}/python.exe"
                },
                "_Python3_INCLUDE_DIR": {
                    "type": "PATH",
                    "value": "$env{PYTHON313}/include"
                },
                "_Python3_LIBRARY_RELEASE": {
                    "type": "FILEPATH",
                    "value": "$env{PYTHON313}/libs/python313.lib"
                }
            }
        },
        {
            "name": "standalone-py312",
            "displayName": "Standalone Python 3.12",
            "inherits": "x64-windows-static-dist-base",
            "binaryDir": "${sourceDir}/build/gdx-standalone-312",
            "cacheVariables": {
                "Python3_ROOT_DIR": "$env{PYTHON312}",
                "Python3_EXECUTABLE": {
                    "type": "FILEPATH",
                    "value": "$env{PYTHON312}/python.exe"
                },
                "_Python3_INCLUDE_DIR": {
                    "type": "PATH",
                    "value": "$env{PYTHON312}/include"
                },
                "_Python3_LIBRARY_RELEASE": {
                    "type": "FILEPATH",
                    "value": "$env{PYTHON312}/libs/python312.lib"
                }
            }
        },
        {
            "name": "x64-windows-static-vs",
            "displayName": "Visual Studio",
            "inherits": [
                "project-base",
                "triplet-x64-windows-static",
                "build-system-visualstudio"
            ],
            "binaryDir": "${sourceDir}/build/gdx-vs"
        }
    ],
    "buildPresets": [
        {
            "name": "x64-windows-static-debug",
            "configurePreset": "x64-windows-static",
            "displayName": "Windows x64 Debug",
            "description": "Debug build",
            "configuration": "Debug"
        },
        {
            "name": "x64-windows-static-release",
            "configurePreset": "x64-windows-static",
            "displayName": "Windows x64 Release",
            "description": "Release build",
            "configuration": "Release"
        },
        {
            "name": "x64-windows-static-dist",
            "configurePreset": "x64-windows-static-dist",
            "displayName": "Windows x64 Dist",
            "description": "Dist build"
        },
        {
            "name": "standalone-py314",
            "configurePreset": "standalone-py314",
            "displayName": "Standalone Python 3.14",
            "description": "Standalone build for Python 3.14"
        },
        {
            "name": "standalone-py313",
            "configurePreset": "standalone-py313",
            "displayName": "Standalone Python 3.13",
            "description": "Standalone build for Python 3.13"
        },
        {
            "name": "standalone-py312",
            "configurePreset": "standalone-py312",
            "displayName": "Standalone Python 3.12",
            "description": "Standalone build for Python 3.12"
        },
        {
            "name": "nix-debug",
            "configurePreset": "nix",
            "displayName": "Debug Nix Build",
            "configuration": "Debug"
        },
        {
            "name": "nix-release",
            "configurePreset": "nix",
            "displayName": "Release Nix Build",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "x64-windows-static-debug",
            "description": "Unit tests",
            "configurePreset": "x64-windows-static",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x64-windows-static-release",
            "description": "Unit tests",
            "configurePreset": "x64-windows-static",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x64-windows-static-dist",
            "description": "Unit tests for windows distribution build",
            "configurePreset": "x64-windows-static-dist",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "nix-debug",
            "description": "Unit tests",
            "configurePreset": "nix",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "nix-release",
            "description": "Unit tests",
            "configurePreset": "nix",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
